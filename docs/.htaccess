# =============================================================================
#  Andijon AI Talents — docs/ papkasi yopiq / directory is closed
#  UZ: Loyiha hujjatlari (.md fayllar) — o'rnatish yo'riqnomasi ichki
#      foydalanish uchun.
#  EN: Project documentation (.md files); the deployment guide is for internal
#      use.
#
#  UZ: Bu fayl papkani brauzerdan butunlay yopadi. PHP kodi fayllarni disk
#      orqali o'qiydi, shuning uchun bot va admin panel ishlashda davom etadi.
#      Bu faylni O'CHIRMANG va git'dan chiqarmang.
#  EN: This file closes the directory to the web only. PHP still reads these
#      files from disk, so the bot and the panel keep working. Do not delete it.
#
#  UZ: Ba'zi hostinglar .htaccess'ni umuman o'qimaydi (nginx, ba'zi VPS
#      sozlamalari). Bunday holda papkalarni veb-ildizdan (public_html)
#      tashqariga chiqarish yoki server konfiguratsiyasida yopish kerak.
#  EN: On servers that ignore .htaccess (nginx and some VPS setups) move these
#      directories outside the document root or deny them in the vhost config.
# =============================================================================

# UZ: Papka ro'yxati ko'rinmasin. / EN: No directory listing.
Options -Indexes

# UZ: Apache 2.4 (mod_authz_core mavjud). / EN: Apache 2.4 syntax.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# UZ: Apache 2.2 (eski sintaksis, mod_authz_core yo'q).
# EN: Apache 2.2 fallback — mod_authz_core does not exist there.
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# UZ: Yuqoridagi qoidalar ishlamagan taqdirda ham hech qanday fayl bevosita
#     ochilmasligi uchun qo'shimcha qatlam.
# EN: Extra layer in case the directives above are overridden higher up.
<FilesMatch ".*">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

